{
	"name": "suwa-ui",
	"type": "module",
	"author": "PHNTMbandit",
	"description": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/PHNTMbandit/suwa-ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/suwa-ui.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/suwa-ui.es.js",
			"default": "./dist/suwa-ui.es.js"
		},
		"./styles.css": "./dist/styles.css",
		"./styles": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/styles.css"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build  && pnpm run build:css",
		"build:css": "node -e \"require('fs').copyFileSync('src/styles/input.css', 'dist/styles.css')\"",
		"lint": "biome check --write",
		"preview": "vite preview",
		"test": "vitest run",
		"storybook": "concurrently 'pnpm:watch:*'",
		"watch:storybook": "storybook dev -p 6006",
		"watch:tailwind": "pnpx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch",
		"build:tailwind": "pnpx @tailwindcss/cli -i ./src/styles/input.css -o ./dist/styles.css",
		"build-storybook": "pnpm build:tailwind && storybook build",
		"cz": "cz"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"react-resizable-panels": "^4.7.3",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@chromatic-com/storybook": "^5.0.1",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@faker-js/faker": "^10.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@storybook/addon-a11y": "^10.3.0",
		"@storybook/addon-docs": "^10.3.0",
		"@storybook/addon-onboarding": "^10.3.0",
		"@storybook/addon-themes": "^10.3.0",
		"@storybook/addon-vitest": "^10.3.0",
		"@storybook/react-vite": "^10.3.0",
		"@tailwindcss/cli": "^4.2.2",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/react-form": "^1.28.5",
		"@tanstack/react-table": "^8.21.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"cz-conventional-changelog": "^3.3.0",
		"globals": "^17.4.0",
		"jsdom": "^29.0.0",
		"lefthook": "^2.1.4",
		"playwright": "^1.58.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-test-renderer": "^19.2.4",
		"semantic-release": "^25.0.3",
		"standard-version": "^9.5.0",
		"storybook": "^10.3.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.0",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@tanstack/react-table": "^8.21.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"use-sync-external-store": "^1.2.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"version": "1.0.0-beta.34"
}
